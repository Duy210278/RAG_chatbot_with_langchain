# Sao chép file này thành ".env" trong thư mục gốc dự án rồi điền giá trị của bạn.
# Có thể để trống API key ở đây và nhập trực tiếp trên giao diện Streamlit thay vào đó.

# --- LLM Providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DEFAULT_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

# --- Embedding (chạy local, không cần API key) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Retrieval / Chunking ---
DEFAULT_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
