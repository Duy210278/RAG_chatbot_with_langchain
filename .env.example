# Sao chép file này thành ".env" trong thư mục gốc dự án rồi điền giá trị của bạn.
# API key CHỈ khai báo ở đây - giao diện Streamlit không còn ô nhập API key nữa.
# Provider nào có key ở đây sẽ TỰ ĐỘNG xuất hiện trong dropdown "Provider" trên UI
# (xem GET /api/v1/config/providers) - không cần khai báo hết cả 5, chỉ cần provider bạn dùng.

# --- LLM Providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Danh sách model cho từng provider, phân cách bằng dấu phẩy - model ĐẦU TIÊN là mặc định.
# UI hiển thị đúng danh sách này dưới dạng dropdown (không gõ tay tên model nữa).
ANTHROPIC_MODELS=claude-sonnet-5,claude-opus-5,claude-haiku-4-5-20251001,claude-fable-5-1
OPENAI_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1,gpt-4.1-mini,gpt-4.1-nano,o3-mini,o1
XAI_MODELS=grok-4,grok-4-fast
GEMINI_MODELS=gemini-3.6-flash,gemini-2.5-flash,gemini-2.5-pro,gemini-2.5-flash-lite,gemini-2.0-flash
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# --- Lịch sử hội thoại (multi-turn) ---
# Số tin nhắn lịch sử tối đa gửi kèm làm ngữ cảnh cho LLM (0 = tắt, chỉ dùng câu hỏi hiện tại)
MAX_HISTORY_MESSAGES=20

# --- Embedding (chạy local, không cần API key) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Retrieval / Chunking ---
DEFAULT_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Reranker (cross-encoder chấm lại kết quả vector search, chạy local) ---
# Model mặc định nhỏ, nhanh trên CPU (~0.8s/20 đoạn). Có GPU thì nên đổi sang BAAI/bge-reranker-v2-m3
# (chính xác hơn, nhưng ~9s/20 đoạn trên CPU).
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=20
# Điểm liên quan tối thiểu (0-1) để 1 đoạn được gửi cho LLM
RERANK_THRESHOLD=0.3

# --- Gửi kèm đoạn liền kề cho các đoạn đứng đầu (bù slide vụn / điều khoản bị cắt ở ranh giới trang) ---
# Số đoạn lấy thêm mỗi phía (0 = tắt) và số đoạn đứng đầu được mở rộng
NEIGHBOR_WINDOW=1
NEIGHBOR_TOP_N=3

# --- Khi LLM hết quota ---
# Chatbot báo rõ model nào hết quota rồi trả thẳng N đoạn tài liệu gốc tìm được (chưa qua LLM)
QUOTA_FALLBACK_RESULTS=3

# --- Câu hỏi gợi ý (cột bên phải khung chat): FAQ soạn tay + "Hay được hỏi" từ query_logs ---
# Mặc định đọc backend/faq.json - chỉ cần khai báo nếu muốn dùng file khác.
# FAQ_PATH=/duong/dan/toi/faq.json
# Số câu hiển thị cho MỖI nhóm
SUGGESTION_LIMIT=5
# "Hay được hỏi": chỉ xét N ngày gần nhất, và câu phải được hỏi ở ít nhất N cuộc trò chuyện khác nhau
POPULAR_DAYS=30
POPULAR_MIN_SESSIONS=2

# --- Log ---
LOG_LEVEL=INFO
# pretty = mỗi dòng ngắn, có màu, dễ đọc trên terminal khi dev; json = mỗi dòng 1 object cho Loki/ELK
LOG_FORMAT=pretty
# Ẩn access log của các GET thành công (UI gọi lại liên tục mỗi lần tải lại); lỗi và POST/DELETE vẫn in
LOG_QUIET_ACCESS=true
# Hiện "Prompt gửi cho LLM" dưới mỗi câu trả lời (system + lịch sử + ngữ cảnh); tắt khi không muốn lộ system prompt
EXPOSE_PROMPT=true
