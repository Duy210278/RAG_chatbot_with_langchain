# Sao chép file này thành ".env" trong thư mục gốc dự án rồi điền giá trị của bạn.
# API key CHỈ khai báo ở đây - giao diện Streamlit không còn ô nhập API key nữa.
# Provider nào có key ở đây sẽ TỰ ĐỘNG xuất hiện trong dropdown "Provider" trên UI
# (xem GET /api/v1/config/providers) - không cần khai báo hết cả 5, chỉ cần provider bạn dùng.

# --- LLM Providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
# OpenRouter: 1 key dùng được model của nhiều hãng (openrouter.ai/keys)
OPENROUTER_API_KEY=

# Danh sách model cho từng provider, phân cách bằng dấu phẩy - model ĐẦU TIÊN là mặc định.
# UI hiển thị đúng danh sách này dưới dạng dropdown (không gõ tay tên model nữa).
ANTHROPIC_MODELS=claude-sonnet-5,claude-opus-5,claude-haiku-4-5-20251001,claude-fable-5-1
OPENAI_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1,gpt-4.1-mini,gpt-4.1-nano,o3-mini,o1
XAI_MODELS=grok-4,grok-4-fast
GEMINI_MODELS=gemini-3.6-flash,gemini-2.5-flash,gemini-2.5-pro,gemini-2.5-flash-lite,gemini-2.0-flash
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Model ID của OpenRouter luôn dạng "hãng/model". Xem danh sách đầy đủ ở openrouter.ai/models
# (bản đuôi ":free" miễn phí nhưng giới hạn lượt gọi).
OPENROUTER_MODELS=openai/gpt-6-luna,meta-llama/llama-4-maverick,deepseek/deepseek-v4.1-flash,google/gemini-3.8-flash,anthropic/claude-sonnet-5.5,nvidia/nemotron-3.5-lightning:free

# --- Lịch sử hội thoại (multi-turn) ---
# Số tin nhắn lịch sử tối đa gửi kèm làm ngữ cảnh cho LLM (0 = tắt, chỉ dùng câu hỏi hiện tại)
MAX_HISTORY_MESSAGES=20

# --- Embedding (chạy local, không cần API key) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Retrieval / Chunking ---
# LƯU Ý: DEFAULT_TOP_K hiện KHÔNG có tác dụng - không chỗ nào trong code đọc nó.
# Top-K thật lấy từ thanh trượt trên UI (mặc định 12, tối đa 30); gọi API trực tiếp thì
# truyền "top_k" trong body /chat/completions (mặc định 12).
DEFAULT_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Reranker (cross-encoder chấm lại kết quả vector search, chạy local) ---
# Model mặc định nhỏ, nhanh trên CPU (~0.8s/20 đoạn). Có GPU thì nên đổi sang BAAI/bge-reranker-v2-m3
# (chính xác hơn, nhưng ~9s/20 đoạn trên CPU).
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=20
# Điểm liên quan tối thiểu (0-1) để 1 đoạn được gửi cho LLM
RERANK_THRESHOLD=0.3

# --- Gửi kèm đoạn liền kề cho các đoạn đứng đầu (bù slide vụn / điều khoản bị cắt ở ranh giới trang) ---
# Số đoạn lấy thêm mỗi phía (0 = tắt) và số đoạn đứng đầu được mở rộng
NEIGHBOR_WINDOW=1
NEIGHBOR_TOP_N=3

# --- Khi LLM hết quota ---
# Chatbot báo rõ model nào hết quota rồi trả thẳng N đoạn tài liệu gốc tìm được (chưa qua LLM)
QUOTA_FALLBACK_RESULTS=3

# --- Câu hỏi gợi ý (cột bên phải khung chat): FAQ soạn tay + "Hay được hỏi" từ query_logs ---
# Mặc định đọc backend/faq.json - chỉ cần khai báo nếu muốn dùng file khác.
# FAQ_PATH=/duong/dan/toi/faq.json
# Số câu hiển thị cho MỖI nhóm
SUGGESTION_LIMIT=5
# "Hay được hỏi": chỉ xét N ngày gần nhất, và câu phải được hỏi ở ít nhất N cuộc trò chuyện khác nhau
POPULAR_DAYS=30
POPULAR_MIN_SESSIONS=2

# --- Truy hồi lai: vector dense + từ khoá BM25 (SQLite FTS5), trộn bằng RRF ---
# Bù đúng điểm yếu của vector: tra theo mã số/số hiệu văn bản ("mẫu 01-HĐLĐ", "Điều 8").
USE_HYBRID_SEARCH=true
# Số chunk lấy từ nhánh BM25 trước khi trộn
LEXICAL_CANDIDATES=30
# Hằng số RRF - càng lớn càng san bằng chênh lệch thứ hạng giữa hai nhánh
RRF_K=60

# --- Viết lại câu hỏi nối tiếp thành câu độc lập trước khi truy hồi ---
# Chỉ chạy khi có lịch sử hội thoại (tốn thêm 1 lượt gọi LLM ngắn). Quá hạn -> dùng câu hỏi gốc.
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_TIMEOUT=8.0

# --- Chế độ Agent: LLM tự quyết tìm gì, tìm mấy lần trước khi soạn câu trả lời ---
# Người dùng bật/tắt theo từng câu hỏi trong "Tuỳ chọn truy hồi nâng cao" (mặc định tắt).
# false = ẩn hẳn công tắc trên UI và bỏ qua "use_agent" trong request.
AGENT_MODE_ENABLED=true
# Số lượt gọi LLM tối đa của agent (chưa tính lượt soạn câu trả lời)
AGENT_MAX_STEPS=4
# Giây cho MỖI lượt. Quá hạn ở lượt đầu -> quay về chế độ thường; ở lượt sau -> dùng những gì đã tìm được
AGENT_STEP_TIMEOUT=20.0

# --- Log ---
LOG_LEVEL=INFO
# pretty = mỗi dòng ngắn, có màu, dễ đọc trên terminal khi dev; json = mỗi dòng 1 object cho Loki/ELK
LOG_FORMAT=pretty
# Ẩn access log của các GET thành công (UI gọi lại liên tục mỗi lần tải lại); lỗi và POST/DELETE vẫn in
LOG_QUIET_ACCESS=true
# Hiện "Prompt gửi cho LLM" dưới mỗi câu trả lời (system + lịch sử + ngữ cảnh); tắt khi không muốn lộ system prompt
EXPOSE_PROMPT=true

# --- Vector store & API ---
# Tên collection trên Qdrant
QDRANT_COLLECTION=rag_chunks
# Domain được phép gọi API. Phải là mảng JSON (dạng a.com,b.com sẽ lỗi khởi động).
# Mặc định ["*"] - mở cho mọi nguồn, chỉ phù hợp khi chạy localhost.
# CORS_ORIGINS=["http://localhost:8501"]
